{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nrc.example/schemas/edge-recording-manifest.v1.schema.json",
  "title": "NRC Edge Recording Manifest v1",
  "description": "Provenance for an inspected MCAP recording. Source publish times and recorder log times remain separate nanosecond values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gatewayVersion",
    "recordedAtUnixMs",
    "dataOrigin",
    "ingestionMode",
    "robotId",
    "sourceId",
    "fileName",
    "fileSizeBytes",
    "sha256Hex",
    "mcapProfile",
    "mcapLibrary",
    "messageCount",
    "topicCount",
    "channelCount",
    "timestamps",
    "channels"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gatewayVersion": { "type": "string", "minLength": 1 },
    "recordedAtUnixMs": { "type": "integer", "minimum": 1 },
    "dataOrigin": {
      "enum": ["PHYSICAL_SENSOR", "SIMULATED", "DATASET", "UNKNOWN"]
    },
    "ingestionMode": { "const": "RECORDED" },
    "robotId": { "type": "string", "minLength": 1 },
    "sourceId": { "type": "string", "minLength": 1 },
    "fileName": { "type": "string", "minLength": 1 },
    "fileSizeBytes": { "type": "integer", "minimum": 16 },
    "sha256Hex": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mcapProfile": { "type": "string" },
    "mcapLibrary": { "type": "string" },
    "messageCount": { "type": "integer", "minimum": 1 },
    "topicCount": { "type": "integer", "minimum": 1 },
    "channelCount": { "type": "integer", "minimum": 1 },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "logTimeUnixNs", "publishTimeUnixNs"],
      "properties": {
        "unit": { "const": "nanoseconds" },
        "logTimeUnixNs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          }
        },
        "publishTimeUnixNs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max", "zeroCount"],
          "properties": {
            "min": { "type": ["integer", "null"], "minimum": 0 },
            "max": { "type": ["integer", "null"], "minimum": 0 },
            "zeroCount": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channelId",
          "topic",
          "messageEncoding",
          "schemaName",
          "schemaEncoding",
          "channelMetadata",
          "messageCount",
          "minPublishTimeUnixNs",
          "maxPublishTimeUnixNs",
          "publishTimeZeroCount",
          "minLogTimeUnixNs",
          "maxLogTimeUnixNs",
          "firstSequence",
          "lastSequence",
          "minSequence",
          "maxSequence"
        ],
        "properties": {
          "channelId": { "type": "integer", "minimum": 0 },
          "topic": { "type": "string", "minLength": 1 },
          "messageEncoding": { "type": "string", "minLength": 1 },
          "schemaName": { "type": ["string", "null"] },
          "schemaEncoding": { "type": ["string", "null"] },
          "channelMetadata": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "messageCount": { "type": "integer", "minimum": 1 },
          "minPublishTimeUnixNs": { "type": ["integer", "null"], "minimum": 0 },
          "maxPublishTimeUnixNs": { "type": ["integer", "null"], "minimum": 0 },
          "publishTimeZeroCount": { "type": "integer", "minimum": 0 },
          "minLogTimeUnixNs": { "type": "integer", "minimum": 0 },
          "maxLogTimeUnixNs": { "type": "integer", "minimum": 0 },
          "firstSequence": { "type": "integer", "minimum": 0 },
          "lastSequence": { "type": "integer", "minimum": 0 },
          "minSequence": { "type": "integer", "minimum": 0 },
          "maxSequence": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
