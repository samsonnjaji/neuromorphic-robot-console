        }
      },
      "post": {
        "operationId": "createRecordingSession",
        "summary": "Create a recording session",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRecordingSessionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Recording session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordingSessionRecord"
                }
              }
            }
          },
          "400": {
            "description": "Invalid recording session request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Experiment run not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
