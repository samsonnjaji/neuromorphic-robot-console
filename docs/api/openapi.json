  "x-websocket-endpoints": {
    "/api/v1/robots/{robotId}/stream": {
      "description": "WebSocket endpoint. Connect using ws:// or wss:// with the robotId path parameter. The server sends JSON TelemetryEnvelope messages when snapshots are accepted. The current hub retains only the latest snapshot and a bounded in-memory buffer.",
      "pathParameters": {
        "robotId": {
          "type": "string",
          "required": true
        }
      },
      "messageSchema": {
        "$ref": "../../schemas/telemetry-envelope.v1.schema.json"
      }
    },
    "/api/v1/robots/{robotId}/observations/stream": {
      "description": "WebSocket endpoint for compact sensor.observation events. The bounded in-memory hub retains only the latest event and a bounded buffer; raw high-bandwidth sensor data belongs in MCAP/object-storage artifacts.",
      "pathParameters": {
        "robotId": {
          "type": "string",
          "required": true
        }
      },
      "messageSchema": {
        "$ref": "../../schemas/sensor-observation-envelope.v1.schema.json"
      }
    }
  },
