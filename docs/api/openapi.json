{
  "openapi": "3.1.0",
  "info": {
    "title": "NRC Platform API",
    "version": "1.0.0",
    "description": "Versioned API for experiment definitions, experiment runs, recording-session metadata and read-only telemetry ingestion/streaming. The current MVP is local-only and unauthenticated; do not expose it publicly."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Get API health",
        "responses": {
          "200": {
            "description": "API process is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/experiments": {
      "get": {
        "operationId": "listExperiments",
        "summary": "List experiment metadata",
        "responses": {
          "200": {
            "description": "Most recent experiment records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExperimentRecord"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createExperiment",
        "summary": "Create experiment metadata",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExperimentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Experiment created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentRecord"
                }
              }
            }
          },
          "400": {
            "description": "Invalid experiment request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/experiments/{experimentId}": {
      "get": {
        "operationId": "getExperiment",
        "summary": "Get one experiment",
        "parameters": [
          {
            "name": "experimentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Experiment found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentRecord"
                }
              }
            }
          },
          "404": {
            "description": "Experiment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/robots/{robotId}/telemetry": {
      "post": {
        "operationId": "ingestTelemetry",
        "summary": "Ingest a telemetry snapshot",
        "parameters": [
          {
            "name": "robotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../schemas/telemetry-envelope.v1.schema.json"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Telemetry accepted for live fan-out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelemetryAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Telemetry rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/experiments/{experimentId}/runs": {
      "get": {
        "operationId": "listExperimentRuns",
        "summary": "List runs for an experiment",
        "parameters": [
          {
            "name": "experimentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Experiment runs, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExperimentRunRecord"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Experiment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createExperimentRun",
        "summary": "Create an experiment run",
        "parameters": [
          {
            "name": "experimentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExperimentRunRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Experiment run created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentRunRecord"
                }
              }
            }
          },
          "400": {
            "description": "Invalid run request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Experiment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{runId}": {
      "get": {
        "operationId": "getExperimentRun",
        "summary": "Get an experiment run",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Experiment run found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentRunRecord"
                }
              }
            }
          },
          "404": {
            "description": "Experiment run not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{runId}/transition": {
      "post": {
        "operationId": "transitionExperimentRun",
        "summary": "Advance an experiment run lifecycle state",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransitionExperimentRunRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Experiment run updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentRunRecord"
                }
              }
            }
          },
          "400": {
            "description": "Invalid transition request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Experiment run not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Lifecycle transition is not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{runId}/recordings": {
      "get": {
        "operationId": "listRecordingSessions",
        "summary": "List recording sessions for a run",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recording sessions, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecordingSessionRecord"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Experiment run not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createRecordingSession",
        "summary": "Create a recording session",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRecordingSessionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Recording session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordingSessionRecord"
                }
              }
            }
          },
          "400": {
            "description": "Invalid recording session request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Experiment run not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recordings/{recordingId}": {
      "get": {
        "operationId": "getRecordingSession",
        "summary": "Get a recording session",
        "parameters": [
          {
            "name": "recordingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recording session found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordingSessionRecord"
                }
              }
            }
          },
          "404": {
            "description": "Recording session not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recordings/{recordingId}/transition": {
      "post": {
        "operationId": "transitionRecordingSession",
        "summary": "Advance a recording session lifecycle state",
        "parameters": [
          {
            "name": "recordingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransitionRecordingSessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recording session updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordingSessionRecord"
                }
              }
            }
          },
          "400": {
            "description": "Invalid transition request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Recording session not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Lifecycle transition is not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "x-websocket-endpoints": {
    "/api/v1/robots/{robotId}/stream": {
      "description": "WebSocket endpoint. Connect using ws:// or wss:// with the robotId path parameter. The server sends JSON TelemetryEnvelope messages when snapshots are accepted. The current hub retains only the latest snapshot and a bounded in-memory buffer.",
      "pathParameters": {
        "robotId": {
          "type": "string",
          "required": true
        }
      },
      "messageSchema": {
        "$ref": "../../schemas/telemetry-envelope.v1.schema.json"
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "apiVersion"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string",
            "const": "nrc-platform-api"
          },
          "apiVersion": {
            "type": "string",
            "const": "v1"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "CreateExperimentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "scenario",
          "sourceType",
          "sourceId",
          "modelIdentifier",
          "modelVersion"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string"
          },
          "scenario": {
            "type": "string",
            "enum": [
              "CLEAR",
              "HEAVY_RAIN",
              "FOG",
              "LOW_LIGHT",
              "DUST_SMOKE"
            ]
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "SIMULATOR",
              "ROS2_LIVE",
              "MCAP_RECORDING",
              "ROS_BAG_RECORDING",
              "CARLA_SIMULATION",
              "ISAAC_SIMULATION"
            ]
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "modelIdentifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "modelVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "ExperimentRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "scenario",
          "sourceType",
          "sourceId",
          "modelIdentifier",
          "modelVersion",
          "createdAtUnixMs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "scenario": {
            "type": "string"
          },
          "sourceType": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "modelIdentifier": {
            "type": "string"
          },
          "modelVersion": {
            "type": "string"
          },
          "createdAtUnixMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "TelemetryAcceptedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "robotId",
          "sequence"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "accepted"
          },
          "robotId": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "CreateExperimentRunRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceRevision": {
            "type": "string",
            "maxLength": 128,
            "default": ""
          },
          "configuration": {
            "type": "object",
            "additionalProperties": true,
            "default": {}
          }
        }
      },
      "ExperimentRunRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "experimentId",
          "status",
          "sourceRevision",
          "configuration",
          "failureReason",
          "createdAtUnixMs",
          "updatedAtUnixMs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "experimentId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "RUNNING",
              "COMPLETED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "sourceRevision": {
            "type": "string"
          },
          "configuration": {
            "type": "object",
            "additionalProperties": true
          },
          "resultSummary": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "failureReason": {
            "type": "string"
          },
          "createdAtUnixMs": {
            "type": "integer",
            "minimum": 0
          },
          "startedAtUnixMs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "finishedAtUnixMs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "updatedAtUnixMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "TransitionExperimentRunRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "RUNNING",
              "COMPLETED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "resultSummary": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "failureReason": {
            "type": "string",
            "default": ""
          }
        }
      },
      "CreateRecordingSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "sourceId"
        ],
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "MCAP",
              "ROSBAG2",
              "NRC_JSONL",
              "OTHER"
            ]
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "default": {}
          }
        }
      },
      "RecordingSessionRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "experimentRunId",
          "status",
          "format",
          "sourceId",
          "sampleCount",
          "metadata",
          "failureReason",
          "createdAtUnixMs",
          "updatedAtUnixMs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "experimentRunId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "RECORDING",
              "FINALIZED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "MCAP",
              "ROSBAG2",
              "NRC_JSONL",
              "OTHER"
            ]
          },
          "sourceId": {
            "type": "string"
          },
          "sampleCount": {
            "type": "integer",
            "minimum": 0
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "failureReason": {
            "type": "string"
          },
          "createdAtUnixMs": {
            "type": "integer",
            "minimum": 0
          },
          "startedAtUnixMs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "finishedAtUnixMs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "updatedAtUnixMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "TransitionRecordingSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "RECORDING",
              "FINALIZED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "sampleCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "failureReason": {
            "type": "string",
            "default": ""
          }
        }
      }
    }
  }
}
