{
  "openapi": "3.1.0",
  "info": {
    "title": "NRC Platform API",
    "version": "1.0.0",
    "description": "Versioned API for experiment definitions, runs, recording sessions, verified S3-compatible artifacts and read-only telemetry. The local MVP binds to loopback; authentication is not yet implemented."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Get API health",
        "responses": {
          "200": {
            "description": "API process is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/experiments": {
      "get": {
        "operationId": "listExperiments",
        "summary": "List experiment metadata",
        "responses": {
          "200": {
            "description": "Most recent experiment records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExperimentRecord"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createExperiment",
        "summary": "Create experiment metadata",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExperimentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Experiment created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentRecord"
                }
              }
            }
          },
          "400": {
            "description": "Invalid experiment request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/experiments/{experimentId}": {
      "get": {
        "operationId": "getExperiment",
        "summary": "Get one experiment",
        "parameters": [
          {
            "name": "experimentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Experiment found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentRecord"
                }
              }
            }
          },
          "404": {
            "description": "Experiment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/robots/{robotId}/telemetry": {
      "post": {
        "operationId": "ingestTelemetry",
        "summary": "Ingest a telemetry snapshot",
        "parameters": [
          {
            "name": "robotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../schemas/telemetry-envelope.v1.schema.json"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Telemetry accepted for live fan-out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelemetryAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Telemetry rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/robots/{robotId}/observations": {
      "post": {
        "operationId": "ingestSensorObservation",
        "summary": "Ingest a bounded sensor observation",
        "parameters": [
          {
            "name": "robotId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../schemas/sensor-observation-envelope.v1.schema.json"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Sensor observation accepted for bounded live fan-out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SensorObservationAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Sensor observation rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
