# Local development only. Populate credentials before starting Compose; never commit .env.
NRC_DB_CREDENTIAL=
NRC_POSTGRES_HOST_PORT=5432
NRC_OBJECT_STORE_ACCESS_KEY=
NRC_OBJECT_STORE_SECRET_KEY=
NRC_OBJECT_STORE_HOST_PORT=9000
NRC_OBJECT_STORE_CONSOLE_HOST_PORT=9001
NRC_OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
NRC_OBJECT_STORE_BUCKET=nrc-artifacts
NRC_OBJECT_STORE_REGION=us-east-1
NRC_OBJECT_STORE_PATH_STYLE=true
NRC_OBJECT_STORE_PRESIGN_TTL_SECONDS=900
NRC_ARTIFACT_PENDING_UPLOAD_TTL_SECONDS=86400
NRC_ARTIFACT_CLEANUP_GRACE_SECONDS=3600
NRC_ARTIFACT_CLEANUP_INTERVAL_SECONDS=900
NRC_ARTIFACT_CLEANUP_BATCH_SIZE=100
